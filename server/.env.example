PORT=5000
NODE_ENV=development

LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=google

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat-bot?retryWrites=true&w=majority

CLIENT_URL=http://localhost:5173

MONITORING_ENABLED=false
MONITORING_API_URL=https://your-monitoring-platform.com/api/v1
MONITORING_API_KEY=sk_test_xxxxxxxxx

# Sentinel integration (API Key & Application ID are provided by the user in the chat UI)
SENTINEL_ENABLED=true
SENTINEL_INGEST_URL=http://localhost:5000/api/v1/ingest
